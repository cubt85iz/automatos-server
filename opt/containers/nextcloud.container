[Unit]
Description=Container service for Nextcloud
Requires=nextcloud-network.service
Requires=nextcloud-db.service
Wants=nextcloud-clamav.service nextcloud-code.service
Wants=nextcloud-fts.service nextcloud-redis.service
After=nextcloud-network.service
After=nextcloud-clamav.service nextcloud-code.service
After=nextcloud-db.service nextcloud-fts.service 
After=nextcloud-redis.service
PartOf=nextcloud-db.service

[Container]
ContainerName=%p
Image=docker.io/library/nextcloud:30
Volume=${CONTAINER_PATH}/www:/var/www/html:z,rw,rslave,rbind
PublishPort=${WEB_PORT}:80/tcp
Network=nextcloud-network

# Metadata
Label=io.github.cubt85iz.automatos-server.nextcloud.project="https://nextcloud.com"
Label=io.github.cubt85iz.automatos-server.nextcloud.source="https://github.com/nextcloud/server"
Label=io.github.cubt85iz.automatos-server.nextcloud.readme="https://raw.githubusercontent.com/authelia/authelia/refs/heads/master/README.md"
Label=io.github.cubt85iz.automatos-server.nextcloud.instructions="https://raw.githubusercontent.com/nextcloud/server/refs/heads/master/README.md"
Label=io.github.cubt85iz.automatos-server.nextcloud.logo="https://raw.githubusercontent.com/homarr-labs/dashboard-icons/refs/heads/main/webp/nextcloud.webp"
Label=io.github.cubt85iz.automatos-server.nextcloud.category=""
Label=io.github.cubt85iz.automatos-server.nextcloud.references.quadlet="https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html"

[Service]
ExecCondition=/usr/bin/test -d "${CONTAINER_PATH}/www"
Restart=on-failure

[Install]
WantedBy=default.target
