[Unit]
Description=Container service for n8n

[Container]
ContainerName=%p
Image=docker.n8n.io/n8nio/n8n:latest
Volume=${CONTAINER_PATH}/n8n:/home/node/.n8n:Z
PublishPort=${WEB_PORT}:5678
Environment=N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
Environment=N8N_RUNNERS_ENABLED=true
Network=ai-network

# Metadata
Label=io.github.cubt85iz.automatos-server.n8n.project="https://n8n.io"
Label=io.github.cubt85iz.automatos-server.n8n.source="https://github.com/n8n-io/n8n"
Label=io.github.cubt85iz.automatos-server.n8n.readme="https://raw.githubusercontent.com/n8n-io/n8n/refs/heads/master/README.md"
Label=io.github.cubt85iz.automatos-server.n8n.instructions="https://raw.githubusercontent.com/n8n-io/n8n-docs/refs/heads/main/docs/hosting/installation/docker.md"
Label=io.github.cubt85iz.automatos-server.n8n.logo="https://raw.githubusercontent.com/homarr-labs/dashboard-icons/refs/heads/main/webp/n8n.webp"
Label=io.github.cubt85iz.automatos-server.n8n.category=""
Label=io.github.cubt85iz.automatos-server.n8n.references.quadlet="https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html"

[Service]
ExecCondition=/usr/bin/test -d "${CONTAINER_PATH}/n8n"
Restart=on-failure

[Install]
WantedBy=default.target
