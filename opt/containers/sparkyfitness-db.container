[Unit]
Description=Container service for SparkyFitness database
Requires=sparkyfitness-network.service
After=sparkyfitness-network.service

[Container]
ContainerName=%p
Image=docker.io/library/postgres:18-alpine
Volume=${CONTAINER_PATH}/db:/var/lib/postgresql:Z
Network=sparkyfitness-network

[Service]
ExecCondition=/usr/bin/test -d "${CONTAINER_PATH}/db"
ExecStartPre=/usr/bin/chown -R 999 ${CONTAINER_PATH}/db
Restart=on-failure
